# Copy to .env on the server. Never commit the real file.
DOMAIN=smartpathy.io

# Shared password in front of the site (Caddy basic auth).
BASIC_AUTH_USER=
# Output of "caddy hash-password". Keep the single quotes: the hash contains $.
BASIC_AUTH_HASH=''

# Use letters and digits only (openssl rand -hex 24): DB_PASSWORD goes inside a URL.
DB_ROOT_PASSWORD=
DB_PASSWORD=

GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash

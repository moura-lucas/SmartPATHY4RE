# Copy to .env on the server. Never commit the real file.
DOMAIN=smartpathy.io

# Use letters and digits only (openssl rand -hex 24): DB_PASSWORD goes inside a URL.
DB_ROOT_PASSWORD=
DB_PASSWORD=

GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Registering with this email claims the projects created before accounts existed.
# Leave empty if there are none.
LEGACY_OWNER_EMAIL=

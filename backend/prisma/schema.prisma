// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Project {
  id                  String        @id @default(uuid())
  name                String        @db.VarChar(120)
  domain              String        @db.VarChar(80)
  description         String        @db.Text
  additionalContext   String?       @db.Text
  personaName         String?       @db.VarChar(80)
  personaAge          Int?
  techExperienceLevel String        @db.VarChar(16)
  createdAt           DateTime      @default(now())
  persona             Persona?
  requirements        Requirement[]
}

model Persona {
  id                       String   @id @default(uuid())
  projectId                String   @unique
  project                  Project  @relation(fields: [projectId], references: [id])
  name                     String   @db.VarChar(80)
  age                      Int
  techExperienceLevel      String   @db.VarChar(16)
  who                      Json
  context                  Json
  experienceWithTechnology Json
  problems                 Json
  existingSolutions        Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Requirement {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  code        String   @db.VarChar(16)
  type        String   @db.VarChar(16) // "functional" | "non_functional"
  description String   @db.Text
  moscow      String   @db.VarChar(8)
  priority    String   @db.VarChar(8)
  derivedFrom Json // PathyCode[]
  position    Int // order in which PATHY4RE generated it
  createdAt   DateTime @default(now())

  @@unique([projectId, code]) // AC5.5
}

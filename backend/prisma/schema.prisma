// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Imports must still resolve after tsc compiles the client to dist/.
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 String            @id @default(uuid())
  name               String            @db.VarChar(120)
  email              String            @unique @db.VarChar(191)
  passwordHash       String            @db.VarChar(100)
  // The user's own Gemini key, encrypted; only the last characters are ever shown.
  geminiKeyEncrypted String?           @db.Text
  geminiKeyLast4     String?           @db.VarChar(4)
  createdAt          DateTime          @default(now())
  projects           Project[]
  sessions           Session[]
  usage              GenerationUsage[]
}

/**
 * Generations made today with the shared key, per account.
 */
model GenerationUsage {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, day])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @db.Char(64) // SHA-256 of the cookie value
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id                  String        @id @default(uuid())
  // AC18.4: null only for projects created before accounts existed, which nobody can see
  // until LEGACY_OWNER_EMAIL registers.
  userId              String?
  user                User?         @relation(fields: [userId], references: [id])
  name                String        @db.VarChar(120)
  domain              String        @db.VarChar(80)
  description         String        @db.Text
  additionalContext   String?       @db.Text
  personaName         String?       @db.VarChar(80)
  personaAge          Int?
  techExperienceLevel String        @db.VarChar(16)
  createdAt           DateTime      @default(now())
  personas            Persona[]
  requirements        Requirement[]

  @@index([userId])
}

model Persona {
  id                       String        @id @default(uuid())
  projectId                String
  project                  Project       @relation(fields: [projectId], references: [id])
  name                     String        @db.VarChar(80)
  age                      Int
  techExperienceLevel      String        @db.VarChar(16)
  who                      Json
  context                  Json
  experienceWithTechnology Json
  problems                 Json
  existingSolutions        Json
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  // AC14.4: the highest numbers ever used, so a deleted code is never reused.
  lastFunctionalNumber     Int           @default(0)
  lastNonFunctionalNumber  Int           @default(0)
  requirements             Requirement[]

  @@index([projectId])
}

model Requirement {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  personaId   String
  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade) // AC12.5
  code        String   @db.VarChar(16)
  type        String   @db.VarChar(16) // "functional" | "non_functional"
  description String   @db.Text
  moscow      String   @db.VarChar(8)
  priority    String   @db.VarChar(8)
  derivedFrom Json // PathyCode[]
  position    Int // order in which PATHY4RE generated it
  isNew       Boolean  @default(false) // AC13.5: part of the latest additional generation
  edited      Boolean  @default(false) // AC14.5: changed by the user after generation
  createdAt   DateTime @default(now())

  @@unique([personaId, code]) // AC5.5
  @@index([projectId])
}
